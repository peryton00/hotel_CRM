# Desktop configuration. Use a dedicated local PostgreSQL database.
LOCAL_DATABASE_URL=postgresql://pos_user:CHANGE_ME@127.0.0.1:5432/hotel_crm
PORT=3000
ENVIRONMENT=development
ALLOW_DEV_AUTH=false
ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:4200

# Optional. Without a persistent local session key, restart requires staff to sign in again.
# POS_SESSION_SECRET=<random local secret of at least 32 characters>

# Optional public-menu sync. Generate a separate high-entropy device token.
# DEVICE_SYNC_URL=https://your-restaurant-api.onrender.com
# DEVICE_SYNC_TOKEN=<same random device credential as the Render service>

# On Render configure DATABASE_URL, SUPABASE_URL, SUPABASE_JWT_SECRET, DEVICE_SYNC_TOKEN
# and ALLOWED_ORIGINS in its dashboard. Leave LOCAL_DATABASE_URL unset there.
