# HOTEL_CRM Rust API Environment Configuration
PORT=3000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Dual-Pool Offline-First Configuration (Phase 1)
# LOCAL_DATABASE_URL: Primary operational database running locally on restaurant premises (100% offline-first).
# When set, the system automatically routes all POS, orders, billing, and inventory to local PostgreSQL.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_crm_local

# CLOUD_DATABASE_URL: Remote cloud database for transactional outbox sync and customer digital orders.
CLOUD_DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Fallback DATABASE_URL: Used if LOCAL_DATABASE_URL is not configured
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-characters
SUPABASE_URL=https://your-project-ref.supabase.co
ALLOW_DEV_AUTH=true
