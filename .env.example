# HOTEL_CRM Production & Local Environment Variables Example
# Duplicate this file to .env and fill in the values.
# NEVER commit .env to version control or expose database passwords.

# HTTP Server Configuration
PORT=3000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgres://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_crm

# Supabase Authentication & JWT Configuration
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-characters
SUPABASE_URL=https://your-project-ref.supabase.co

# Development Bypass Mode (Set to false in production)
ALLOW_DEV_AUTH=false
